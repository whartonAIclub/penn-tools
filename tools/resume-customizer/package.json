{
  "name": "@penntools/tool-resume-customizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resume": {
      "types": "./dist/resume.d.ts",
      "import": "./dist/resume.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./docx": {
      "types": "./dist/docx.d.ts",
      "import": "./dist/docx.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@penntools/core": "workspace:*",
    "docx": "~9.15.3",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "jszip": "^3.10.2",
    "pdfjs-dist": "^3.11.174",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
