# Copy values into the HOSTED APP's secret/environment settings, not the frontend or Git.
# No real credentials are included. Fill every blank before enabling real delivery.
HANDOFF_EMAIL_PROVIDER=resend
HANDOFF_EMAIL_API_KEY=
HANDOFF_EMAIL_FROM=
HANDOFF_EMAIL_DISPATCH_SECRET=
NEXTAUTH_URL=
# Initial verification recipient: one Penn address (upenn.edu or a subdomain), set on the host, never committed here.
# That person must sign in with Penn Google and opt in.
HANDOFF_EMAIL_ALLOWLIST=
# The separate scheduler needs only the same NEXTAUTH_URL and DISPATCH_SECRET.
# Optional scheduler-only batch size. Default is 5 jobs/run, every minute.
HANDOFF_EMAIL_BATCH_LIMIT=5
