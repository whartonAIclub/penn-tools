{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@penntools/web..."
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @penntools/platform db:push"],
    "startCommand": "pnpm --filter @penntools/web start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
