// ─────────────────────────────────────────────────────────────────────────────
// PennTools Prisma schema
//
// Identity:
//   - Users exist only once they sign in with Google; there are no anonymous
//     users. A users row is created on first sign-in, keyed by google_id.
//   - Every table that holds user data has a user_id column (UUID).
//   - All queries are scoped: WHERE user_id = $userId.
//
// Tool metadata is not stored here: tools ship with the app, so the registry
// in code (each tool's manifest, registered in container.ts) is the source of
// truth. Tools keep their own data in their own schemas, not in public.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// Google account id (OpenID `sub`); every user has signed in with Google.
  googleId  String   @unique @map("google_id")
  /// Display name from Google.
  name      String?
  /// Email from Google.
  email     String?
  /// Profile picture URL from Google.
  image     String?
  /// UPenn identifier (pennid / eppn), reserved for Penn SSO.
  pennId    String?  @unique @map("penn_id")

  apiKeys    UserApiKey[]
  aiUsage    AiUsage[]
  toolVisits ToolVisit[]

  @@map("users")
}

/// A user's own LLM API key, entered on the settings page; at most one per
/// provider, used by the AI API on the user's behalf. Stored in plain text, so
/// it is never sent back to the browser, and tools never receive it and must
/// not read it (see UserApiKeyRepository).
model UserApiKey {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  provider  ApiKeyProvider
  secret    String
  /// The key's last four characters, shown on the settings page.
  last4     String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("user_api_keys")
}

enum ApiKeyProvider {
  OPENAI
  ANTHROPIC
}

// ── Admins ────────────────────────────────────────────────────────────────────

/// Who can open /admin (AI usage, and this list). Keyed by email rather than
/// user, so someone can be made an admin before they first sign in. Admins
/// add and remove each other on /admin; `db:deploy` adds the first ones
/// (scripts/seed-platform.mjs) only while the table is empty.
model Admin {
  /// Lowercase.
  email   String   @id
  addedAt DateTime @default(now()) @map("added_at")
  /// The admin who added them, or null for the first admins.
  addedBy String?  @map("added_by")

  @@map("admins")
}

// ── AI usage ──────────────────────────────────────────────────────────────────

/// One AI call made for a user: which tool and model, its tokens and cost, and
/// whose key paid. A user's free AI credit is spent once their PLATFORM rows,
/// pending reservations included, add up to FREE_CREDIT_USD
/// (packages/core/src/ai/pricing.ts).
model AiUsage {
  id           String         @id @default(uuid())
  createdAt    DateTime       @default(now()) @map("created_at")
  userId       String         @map("user_id")
  /// The calling tool's manifest id, or "unknown" for a legacy call from outside a tool's pages.
  toolId       String         @map("tool_id")
  api          AiUsageApi
  provider     ApiKeyProvider
  model        String
  keySource    AiKeySource    @map("key_source")
  inputTokens  Int            @map("input_tokens")
  /// Reasoning included.
  outputTokens Int            @map("output_tokens")
  /// US dollars at the model's price when the call was made.
  costUsd      Float          @map("cost_usd")
  /// The provider didn't report usage (e.g. a cancelled stream), so the tokens are estimated.
  estimated    Boolean        @default(false)
  /// A reservation for a call on the platform's key that hasn't finished: costUsd
  /// is its expected cost until it's settled. Counts toward the free credit
  /// for RESERVATION_TTL_MINUTES, then is treated as abandoned.
  pending      Boolean        @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, keySource])
  @@index([toolId])
  @@map("ai_usage")
}

// ── Tool visits ───────────────────────────────────────────────────────────────

/// One visit to a tool: opening its pages, signed in or not (moving between
/// pages within a tool isn't another visit). Recorded by the site's tools
/// frame through POST /api/visits; read by /admin.
model ToolVisit {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  /// The tool's manifest id.
  toolId    String   @map("tool_id")
  /// Null for a signed-out visitor.
  userId    String?  @map("user_id")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolId, createdAt])
  @@map("tool_visits")
}

enum AiUsageApi {
  AI
  EMBEDDINGS
  LEGACY
}

enum AiKeySource {
  PLATFORM
  USER
}
