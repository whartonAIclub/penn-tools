// ─────────────────────────────────────────────────────────────────────────────
// PennTools Prisma schema
//
// Identity:
//   - Users exist only once they sign in with Google; there are no anonymous
//     users. A users row is created on first sign-in, keyed by google_id.
//   - Every table that holds user data has a user_id column (UUID).
//   - All queries are scoped: WHERE user_id = $userId.
//
// Tool metadata is not stored here: tools ship with the app, so the registry
// in code (built from each tool's meta.json) is the source of truth.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// Google account id (OpenID `sub`); every user has signed in with Google.
  googleId  String   @unique @map("google_id")
  /// Display name from Google.
  name      String?
  /// Email from Google.
  email     String?
  /// Profile picture URL from Google.
  image     String?
  /// UPenn identifier (pennid / eppn), reserved for Penn SSO.
  pennId    String?  @unique @map("penn_id")

  chats     Chat[]
  messages  Message[]
  toolData  ToolData[]

  @@map("users")
}

// ── Chats ─────────────────────────────────────────────────────────────────────

model Chat {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("chats")
}

// ── Messages ──────────────────────────────────────────────────────────────────

model Message {
  id        String      @id @default(uuid())
  chatId    String      @map("chat_id")
  userId    String      @map("user_id")
  role      MessageRole
  content   String      @db.Text
  /// Null for user/assistant messages; set to the tool id for tool messages.
  toolId    String?     @map("tool_id")
  createdAt DateTime    @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

// ── Tool data ─────────────────────────────────────────────────────────────────

/// Generic key-value store scoped to (userId, toolId).
/// Allows each tool to persist arbitrary JSON without needing its own table.
model ToolData {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  toolId    String   @map("tool_id")
  key       String
  jsonValue Json     @map("json_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId, key])
  @@index([userId, toolId])
  @@map("tool_data")
}

// ── Resources ─────────────────────────────────────────────────────────────────

/// Penn resources and AskPenn tool entries stored with vector embeddings for
/// semantic retrieval.  The embedding column uses pgvector (vector(1536)) and
/// is populated by the platform on upsert.  Raw SQL is required for the
/// vector column because Prisma marks it as Unsupported.
model Resource {
  id        String   @id
  title     String
  url       String
  /// Combined text used for embedding: title + description + intent + tags.
  content   String   @db.Text
  /// text-embedding-3-small produces 1536-dimensional vectors.
  embedding Unsupported("vector(1536)")?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("resources")
}
