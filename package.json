{
  "name": "penntools",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev --concurrency=50",
    "postinstall": "pnpm --filter @penntools/platform db:generate",
    "build": "turbo build",
    "test": "turbo test && node --test \"scripts/*.test.mjs\"",
    "typecheck": "turbo typecheck",
    "check:tools": "node scripts/check-tool-imports.mjs",
    "new-tool": "node scripts/new-tool.mjs",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "canvas"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
