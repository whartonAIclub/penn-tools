# ─────────────────────────────────────────────────────────────────────────────
# PennTools environment variables
# Copy to .env.local for local development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Postgres, required)
DATABASE_URL="postgresql://user:password@localhost:5432/penntools?schema=public"

# LLM providers (only one needed; platform reads whichever is set).
# OPENAI_API_KEY also powers semantic search and lets db:deploy seed
# Career Canvas's course embeddings.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Google sign-in. Required in production; locally, leave these empty and
# Sign in logs you in as a local development user instead.
# Create an OAuth client ID (type "Web application") in Google Cloud Console
# with redirect URI <site URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Signs session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The site's public URL; required in production (e.g. the Railway domain).
NEXTAUTH_URL="http://localhost:3000"

# Analytics (optional; events are no-op when unset)
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
